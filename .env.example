# MAPBOX_TOKEN: Required for Mapbox GL JS map rendering.
# Users configure this via the Secrets panel in the AI Studio UI.
VITE_MAPBOX_TOKEN="MY_MAPBOX_TOKEN"

# Firebase (required for auth + live Firestore data)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIRESTORE_DATABASE_ID=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Power outages (ENMAX) — no frontend config needed.
# The map reads the live_data/power_outages snapshot published by
# scripts/ingest/power-outages.ts (GitHub Actions). To run that ingest locally,
# set FIREBASE_SERVICE_ACCOUNT to the JSON of a service-account key — the same
# secret the other ingest workflows use. The browser never calls ENMAX itself.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ...}'

# Optional traffic-event ingestion. 511 Alberta now requires a developer key:
# https://511.alberta.ca/developers/doc
ALBERTA_511_API_KEY=

# EmailJS — volunteer form admin notification
# Sign up at https://emailjs.com, create a service + template, copy the IDs here.
VITE_EMAILJS_SERVICE_ID="YOUR_EMAILJS_SERVICE_ID"
VITE_EMAILJS_VOLUNTEER_TEMPLATE_ID="YOUR_EMAILJS_TEMPLATE_ID"
VITE_EMAILJS_PUBLIC_KEY="YOUR_EMAILJS_PUBLIC_KEY"

# ── Weekly digest (server-side only — never VITE_-prefixed) ─────────────────
# These are read by scripts/digest/weekly.ts, which runs in GitHub Actions.
# Anything VITE_ is compiled into the public bundle; an email API key must not
# be. In CI these live as repository secrets (RESEND_API_KEY) and repository
# variables (the rest) — see .github/workflows/weekly-digest.yml.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
DIGEST_FROM="Calgary Watch <digest@calgarywatch.ca>"
# CASL requires sender identification and a real physical mailing address in
# every commercial email. scripts/digest/render.ts refuses to build a message
# without them, and rejects obvious placeholders.
DIGEST_SENDER_NAME="Calgary Watch"
DIGEST_MAILING_ADDRESS="Street, Calgary, AB, Postal Code"
DIGEST_SUPPORT_EMAIL="hello@calgarywatch.ca"
DIGEST_ORIGIN="https://calgarywatch.ca"
# Safety valves. DIGEST_DRY_RUN renders and logs without transmitting;
# DIGEST_TEST_EMAIL redirects every message to one address; DIGEST_ONLY_UID
# restricts a run to one account; DIGEST_LIMIT caps messages per run.
# DIGEST_DRY_RUN="1"
# DIGEST_TEST_EMAIL="you@example.com"
# DIGEST_ONLY_UID=""
# DIGEST_LIMIT="50"
